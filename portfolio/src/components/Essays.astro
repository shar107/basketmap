---
import { getCollection } from 'astro:content';

const essays = (await getCollection('essays', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);

const fmt = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});
---
<section>
  <h2><span class="glyph">✎</span> notes</h2>
  {essays.length > 0 ? (
    <>
      <ul class="essay-list">
        {essays.map((essay) => (
          <li>
            <a href={`/essays/${essay.id}/`}>{essay.data.title}</a>
            <time datetime={essay.data.date.toISOString()}>{fmt.format(essay.data.date)}</time>
          </li>
        ))}
      </ul>
      <p class="more"><a href="/essays">all notes →</a></p>
    </>
  ) : (
    <p class="empty-note">Long-form build notes will appear here when they are ready to be published.</p>
  )}
</section>
