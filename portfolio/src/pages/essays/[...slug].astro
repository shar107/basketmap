---
import Base from '../../layouts/Base.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const essays = await getCollection('essays', ({ data }) => !data.draft);
  return essays.map((essay) => ({
    params: { slug: essay.id },
    props: { essay },
  }));
}

const { essay } = Astro.props;
const { Content, headings } = await render(essay);

// Table of contents — only h2 / h3
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

// Reading time (~200 wpm)
const words = (essay.body ?? '').split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 200));

const fmt = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});
---
<Base
  title={`${essay.data.title} — Sharad Adhikari`}
  description={essay.data.description}
  canonical={essay.data.canonical}
>
  <div class="essay-layout">
    {toc.length > 0 && (
      <aside class="essay-toc" aria-label="Table of contents">
        <p class="toc-label">contents</p>
        <nav>
          <ul>
            {toc.map((h) => (
              <li class={h.depth === 3 ? 'toc-sub' : ''}>
                <a href={`#${h.slug}`} data-toc-link={h.slug}>{h.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      </aside>
    )}

    <article class="essay-article">
      <p class="back"><a href="/essays">← all essays</a></p>
      <header class="essay-header">
        <h1>{essay.data.title}</h1>
        <div class="essay-byline">
          <span class="author">Sharad Adhikari</span>
          <span class="dot">·</span>
          <time datetime={essay.data.date.toISOString()}>{fmt.format(essay.data.date)}</time>
          <span class="dot">·</span>
          <span>{minutes} min read</span>
        </div>
        {essay.data.substack && (
          <p class="stamp">Also on <a href={essay.data.substack}>Substack</a>.</p>
        )}
      </header>

      <div class="essay-content">
        <Content />
      </div>

      <div class="essay-share" aria-label="Share this essay">
        <span class="share-prompt">Enjoyed this?</span>
        <button type="button" class="share-btn" data-copy>Copy link</button>
      </div>

    </article>
  </div>
  <Footer />
</Base>

<script>
  // 1. Per-heading "copy link" anchors
  const content = document.querySelector('.essay-content');
  if (content) {
    const heads = content.querySelectorAll('h2[id], h3[id]');
    heads.forEach((h) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'heading-anchor';
      btn.setAttribute('aria-label', 'Copy link to this section');
      btn.textContent = '#';
      btn.addEventListener('click', () => {
        const url = location.origin + location.pathname + '#' + h.id;
        navigator.clipboard?.writeText(url);
        history.replaceState(null, '', '#' + h.id);
        btn.textContent = '✓';
        setTimeout(() => (btn.textContent = '#'), 1200);
      });
      h.appendChild(btn);
    });
  }

  // 2. Scroll-spy — highlight current section in the ToC
  const tocLinks = Array.from(document.querySelectorAll('[data-toc-link]'));
  if (tocLinks.length && content) {
    const linkFor = new Map(tocLinks.map((l) => [l.getAttribute('data-toc-link'), l]));
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            tocLinks.forEach((l) => l.classList.remove('active'));
            linkFor.get(entry.target.id)?.classList.add('active');
          }
        });
      },
      { rootMargin: '0px 0px -70% 0px', threshold: 0 }
    );
    content.querySelectorAll('h2[id], h3[id]').forEach((h) => observer.observe(h));
  }

  // 3. Copy link (whole essay)
  const pageUrl = () => location.origin + location.pathname;
  const copyBtn = document.querySelector<HTMLButtonElement>('[data-copy]');
  copyBtn?.addEventListener('click', () => {
    navigator.clipboard?.writeText(pageUrl());
    const original = copyBtn.textContent;
    copyBtn.textContent = 'Copied ✓';
    setTimeout(() => (copyBtn.textContent = original), 1200);
  });
</script>
