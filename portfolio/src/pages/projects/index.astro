---
import Base from '../../layouts/Base.astro';
import Footer from '../../components/Footer.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<Base title="Projects — Sharad Adhikari" description="Products and experiments built by Sharad Adhikari.">
  <article>
    <p class="back"><a href="/">← home</a></p>
    <header>
      <h1>Projects</h1>
      <p class="lede">Products and experiments, including what shipped and what changed along the way.</p>
    </header>

    <div class="project-grid">
      {projects.map((p, i) => (
        <ProjectCard
          num={i + 1}
          href={p.data.url ?? `/projects/${p.id}/`}
          title={p.data.title}
          description={p.data.description}
          tags={p.data.tags}
          status={p.data.status}
        />
      ))}
    </div>

  </article>
  <Footer />
</Base>
